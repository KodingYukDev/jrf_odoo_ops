<odoo>
    <record id="action_report_jrf_request" model="ir.actions.report"><field name="name">Job Request Form</field><field name="model">jrf.request</field><field name="report_type">qweb-pdf</field><field name="report_name">jrf_odoo_ops.report_jrf_request_document</field><field name="report_file">jrf_odoo_ops.report_jrf_request_document</field><field name="binding_model_id" ref="model_jrf_request"/><field name="binding_type">report</field></record>
    <template id="report_jrf_request_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page"><div class="text-center mb-4"><h2>JOB REQUEST FORM</h2><h4><t t-esc="doc.name"/></h4><p><strong>Status:</strong> <t t-esc="dict(doc._fields['state'].selection).get(doc.state)"/> · <strong>Last Update:</strong> <span t-field="doc.write_date" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/></p></div><table class="table table-sm table-bordered"><tbody><tr><th style="width:25%">Requester</th><td><t t-esc="doc.requester_id.name"/> — <t t-esc="doc.requester_department_id.name"/></td><th style="width:20%">Target Department</th><td><t t-esc="doc.target_department_id.name"/></td></tr><tr><th>Request Date</th><td><t t-esc="doc.request_date"/></td><th>Priority</th><td><t t-esc="dict(doc._fields['priority'].selection).get(doc.priority)"/></td></tr><tr><th>Requested Target</th><td><t t-esc="doc.requested_target_date or '-'"/></td><th>Estimated Completion</th><td><t t-esc="doc.estimated_completion or '-'"/></td></tr><tr><th>Assigned PIC</th><td colspan="3"><t t-esc="doc.assigned_pic_id.name or '-'"/></td></tr></tbody></table><h4>Request Description</h4><div t-field="doc.description"/><h4>Business Purpose</h4><div t-field="doc.business_purpose"/><h4>Expected Output</h4><div t-field="doc.expected_output"/><t t-if="doc.completion_notes"><h4>Completion Notes</h4><div t-field="doc.completion_notes"/></t><t t-if="doc.change_ids"><h4>Approved Change Requests</h4><table class="table table-sm table-bordered"><thead><tr><th>Number</th><th>Date</th><th>Impact</th><th>New Estimate</th></tr></thead><tbody><tr t-foreach="doc.change_ids.filtered(lambda c: c.state == 'approved')" t-as="change"><td><t t-esc="change.name"/></td><td><t t-esc="change.request_date"/></td><td><t t-esc="change.impact or '-'"/></td><td><t t-esc="change.new_estimated_completion or '-'"/></td></tr></tbody></table></t><div class="row mt-5"><div class="col-4 text-center"><p style="height:55px"/><strong><t t-esc="doc.requester_id.name"/></strong><br/><small>Requester</small></div><div class="col-4 text-center"><p style="height:55px"/><strong><t t-esc="doc.assigned_pic_id.name or '-'"/></strong><br/><small>PIC</small></div><div class="col-4 text-center"><p style="height:55px"/><strong><t t-esc="doc.target_department_id.manager_id.name or '-'"/></strong><br/><small>Department Head</small></div></div></div></t></t></t></template>
</odoo>
