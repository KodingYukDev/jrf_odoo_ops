<odoo>
    <record id="module_category_jrf" model="ir.module.category"><field name="name">Job Request Form</field><field name="sequence">30</field></record>
    <record id="group_jrf_user" model="res.groups"><field name="name">JRF User</field><field name="category_id" ref="module_category_jrf"/></record>
    <record id="group_jrf_department_head" model="res.groups"><field name="name">JRF Department Head</field><field name="category_id" ref="module_category_jrf"/><field name="implied_ids" eval="[(4, ref('group_jrf_user'))]"/></record>
    <record id="group_jrf_management" model="res.groups"><field name="name">JRF Management</field><field name="category_id" ref="module_category_jrf"/><field name="implied_ids" eval="[(4, ref('group_jrf_department_head'))]"/></record>
    <record id="rule_jrf_user_own" model="ir.rule"><field name="name">JRF user: related records</field><field name="model_id" ref="model_jrf_request"/><field name="groups" eval="[(4, ref('group_jrf_user'))]"/><field name="domain_force">['|','|',('requester_id.user_id','=',user.id),('assigned_pic_id.user_id','=',user.id),('target_department_id.manager_id.user_id','=',user.id)]</field></record>
    <record id="rule_jrf_management_all" model="ir.rule"><field name="name">JRF management: all records</field><field name="model_id" ref="model_jrf_request"/><field name="groups" eval="[(4, ref('group_jrf_management'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
    <record id="rule_jrf_change_user_related" model="ir.rule"><field name="name">JRF change: related request</field><field name="model_id" ref="model_jrf_change"/><field name="groups" eval="[(4, ref('group_jrf_user'))]"/><field name="domain_force">['|','|',('request_id.requester_id.user_id','=',user.id),('request_id.assigned_pic_id.user_id','=',user.id),('request_id.target_department_id.manager_id.user_id','=',user.id)]</field></record>
    <record id="rule_jrf_change_management_all" model="ir.rule"><field name="name">JRF change management: all records</field><field name="model_id" ref="model_jrf_change"/><field name="groups" eval="[(4, ref('group_jrf_management'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
</odoo>
