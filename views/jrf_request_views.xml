<odoo>
    <record id="view_jrf_request_tree" model="ir.ui.view">
        <field name="name">jrf.request.tree</field><field name="model">jrf.request</field>
        <field name="arch" type="xml"><tree decoration-danger="state == 'waiting_requester'" decoration-success="state == 'completed'"><field name="name"/><field name="request_date"/><field name="title"/><field name="requester_department_id"/><field name="target_department_id"/><field name="assigned_pic_id"/><field name="estimated_completion"/><field name="priority" widget="badge"/><field name="state" widget="badge"/></tree></field>
    </record>
    <record id="view_jrf_request_search" model="ir.ui.view">
        <field name="name">jrf.request.search</field><field name="model">jrf.request</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="title"/><field name="requester_id"/><field name="target_department_id"/><filter name="my_request" string="My Requests" domain="[('requester_id.user_id', '=', uid)]"/><filter name="assigned" string="Assigned to Me" domain="[('assigned_pic_id.user_id', '=', uid)]"/><filter name="waiting" string="Waiting for Requester" domain="[('state','=','waiting_requester')]"/><filter name="open" string="Open" domain="[('state','not in',('completed','rejected','cancelled'))]"/><filter name="overdue" string="Overdue" domain="[('estimated_completion','&lt;',context_today().strftime('%Y-%m-%d')),('state','not in',('completed','rejected','cancelled'))]"/><group expand="0" string="Group By"><filter name="group_dept" string="Target Department" context="{'group_by':'target_department_id'}"/><filter name="group_pic" string="PIC" context="{'group_by':'assigned_pic_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_priority" string="Priority" context="{'group_by':'priority'}"/></group></search></field>
    </record>
    <record id="view_jrf_request_form" model="ir.ui.view">
        <field name="name">jrf.request.form</field><field name="model">jrf.request</field>
        <field name="arch" type="xml"><form><header>
            <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'submitted'"/>
            <button name="action_assign" type="object" string="Assign PIC" class="oe_highlight" invisible="state not in ('submitted','approved')"/>
            <button name="action_start" type="object" string="Start Work" class="oe_highlight" invisible="state != 'assigned'"/>
            <button name="action_wait_requester" type="object" string="Wait for Requester" invisible="state not in ('assigned','in_progress')"/>
            <button name="action_resume" type="object" string="Resume" class="oe_highlight" invisible="state != 'waiting_requester'"/>
            <button name="action_submit_review" type="object" string="Submit for Review" class="oe_highlight" invisible="state != 'in_progress'"/>
            <button name="action_accept" type="object" string="Accept Result" class="oe_highlight" invisible="state != 'review'"/>
            <button name="action_request_revision" type="object" string="Request Revision" invisible="state != 'review'"/>
            <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed','rejected','cancelled')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,assigned,in_progress,waiting_requester,review,completed"/>
        </header><sheet><div class="oe_title"><h1><field name="name"/></h1><h2><field name="title" placeholder="Short request title"/></h2></div>
            <group><group string="Request Information"><field name="request_date"/><field name="requester_id"/><field name="requester_department_id"/><field name="target_department_id" readonly="state != 'draft'"/><field name="category"/><field name="priority"/><field name="priority_reason" invisible="priority not in ('high','critical')" required="priority in ('high','critical')"/><field name="requested_target_date"/></group><group string="Assignment &amp; Status"><field name="assigned_pic_id"/><field name="support_pic_ids" widget="many2many_tags"/><field name="estimated_completion"/><field name="accepted_date"/><field name="waiting_for_department_id" invisible="state != 'waiting_requester'"/><field name="waiting_since" invisible="state != 'waiting_requester'"/><field name="waiting_reason" invisible="state != 'waiting_requester'"/></group></group>
            <notebook><page string="Scope"><group><field name="description"/><field name="business_purpose"/><field name="expected_output"/><field name="pic_notes"/></group></page><page string="Result &amp; Acceptance"><group><field name="completion_notes"/><field name="result_url" widget="url"/><field name="repository_url" widget="url"/><field name="deployment_url" widget="url"/><field name="review_submitted_at"/><field name="accepted_by_id"/><field name="accepted_at"/><field name="acceptance_notes"/></group></page><page string="Change Requests"><field name="change_ids"><tree editable="bottom"><field name="name" readonly="1"/><field name="request_date"/><field name="requested_by_id"/><field name="additional_days"/><field name="new_estimated_completion"/><field name="state" widget="badge"/></tree><form><sheet><group><field name="name" readonly="1"/><field name="request_date"/><field name="requested_by_id"/><field name="state"/><field name="description"/><field name="reason"/><field name="impact"/><field name="additional_days"/><field name="new_estimated_completion"/><field name="decision_note"/></group><footer><button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'proposed'"/><button name="action_reject" type="object" string="Reject" invisible="state != 'proposed'"/></footer></sheet></form></field></page></notebook>
        </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field>
    </record>
    <record id="action_jrf_request" model="ir.actions.act_window"><field name="name">Job Requests</field><field name="res_model">jrf.request</field><field name="view_mode">tree,form</field><field name="search_view_id" ref="view_jrf_request_search"/></record>
    <menuitem id="menu_jrf_root" name="Internal Requests" sequence="25" groups="jrf_odoo_ops.group_jrf_user"/>
    <menuitem id="menu_jrf_request" name="Job Requests" parent="menu_jrf_root" action="action_jrf_request" sequence="10"/>
</odoo>
